<html>
<head>
    <style type="text/css">
        body {
            height: 100%;
        }

        body > table {
            width: 100%;
            height: 100%;
            background-color: #f5f5f5;
        }

        body > table > tbody > tr > td
        {
            text-align: center;
        }

        form > table
        {
            margin-left:auto;
            margin-right:auto;
        }

        .error
        {
            font-weight: bold;
            color: red;
        }
        .logo {
            width: 150px;
            margin-bottom: 16px;
        }
        .button {
            width: 100%;
        }
    </style>
</head>

<body>
<table>
    <tr>
        <td>
            <img class="logo" src="data:image/png;base64," />
            <form method="post" action="/jamesui/j_spring_security_check">
                <table>
                    <tr>
                        <td><input type="text" name="j_username" placeholder="Login"/></td>
                    </tr>
                    <tr>
                        <td><input type="password" name="j_password" placeholder="Password"/></td>
                    </tr>
                    <tr>
                        <td><input type="submit" class="button" value="Login"></td>
                    </tr>
                </table>
            </form>

            <#if isError?? && isError?string == "true">
                <div class="error">User or Password not valid</div>
            </#if>

        </td>
    </tr>
</table>
</body>
</html>